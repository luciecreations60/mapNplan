{
  "name": "travel-planner",
  "private": true,
  "version": "0.1.18",
  "type": "module",
  "description": "A modern, extensible travel planning application.",
  "scripts": {
    "dev": "vite",
    "seo:generate": "node scripts/generate-seo-pages.mjs",
    "seo:audit": "node scripts/audit-seo.mjs",
    "prebuild": "npm run seo:generate && npm run seo:audit",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run seo:generate && npm run seo:audit && vite build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.1",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.4",
    "vite": "8.1.5"
  }
}
